# Signs the sessions. Without it a key is generated into the data volume.
# openssl rand -base64 32
EZCADDYMAN_SECRET_KEY=

# Optional: skip the setup page by providing the admin account here.
# The hash is bcrypt. In this file every $ of the hash has to be written as $$.
EZCADDYMAN_ADMIN_USER=
EZCADDYMAN_ADMIN_PASSWORD_HASH=

# Reverse proxy
# Addresses or networks whose X-Forwarded-* headers are trusted, comma separated.
# Behind Caddy: its address or the Docker subnet, e.g. 172.18.0.0/16.
EZCADDYMAN_FORWARDED_ALLOW_IPS=127.0.0.1
