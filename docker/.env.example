# Signs the sessions and encrypts the admin API passwords of your hosts.
# Without it a key is generated into the data volume, next to what it protects.
# openssl rand -base64 32
CADDYMAN_SECRET_KEY=

# Optional: your own token for the setup page, for installs where reading the
# container log is awkward. Without it a random one is printed to the log.
# At least 12 characters; whoever knows it can create the admin account.
CADDYMAN_SETUP_TOKEN=

# Reverse proxy
# Addresses or networks whose X-Forwarded-* headers are trusted, comma separated.
# The Caddy that Caddyman manages is trusted by itself, found under the name in its
# admin API address. Only needed for another proxy in front, e.g. 172.18.0.0/16.
CADDYMAN_FORWARDED_ALLOW_IPS=127.0.0.1

# Way back in: switches "Only answer over HTTPS" (Settings, General) off at the next start.
# Set it to true, start the container, then set it back to false.
CADDYMAN_RESET_HTTPS_ONLY=false

# The time zone the Logs and Changes pages show their times in, like Europe/Berlin.
# One chosen under Settings, General comes before it.
TZ=UTC
