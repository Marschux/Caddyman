# Signs sessions; generated into /data if empty (openssl rand -base64 32)
CADDYMAN_SECRET_KEY=

# Setup token, at least 12 characters; random and printed to the log if empty
CADDYMAN_SETUP_TOKEN=

# Another proxy in front of Caddy whose X-Forwarded-* headers to trust
CADDYMAN_FORWARDED_ALLOW_IPS=127.0.0.1

# true switches "Only answer over HTTPS" off at the next start
CADDYMAN_RESET_HTTPS_ONLY=false

# Time zone for Logs and Changes, e.g. Europe/Berlin
TZ=UTC
